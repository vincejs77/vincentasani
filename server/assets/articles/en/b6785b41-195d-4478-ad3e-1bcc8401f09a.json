		"16e048573e6f": [
			{
				"_key": "87933a9c11360",
				"_type": "span",
				"marks": [],
				"text": "2. Start simple"
			}
		],
		"88bd17a2a78a": [
			{
				"_key": "a566f866cea80",
				"_type": "span",
				"marks": [],
				"text": "No need to unpack a whole encyclopedia.\n3 to 4 well-thought-out fields are often enough to make a big difference:"
			}
		],
		"f19297d1044b": [
			{
				"_key": "ad2e8c105d910",
				"_type": "span",
				"marks": [],
				"text": "Simple, clean, effective. And the AI gives you an answer that actually makes sense."
			}
		],
		"b7aeedc02be5": [
			{
				"_key": "7820f6c90a8b0",
				"_type": "span",
				"marks": [],
				"text": "3. Check your JSON"
			}
		],
		"6d7159306f46": [
			{
				"_key": "863edd9034c90",
				"_type": "span",
				"marks": [],
				"text": "A badly closed JSON is like a sentence that stops mid-flight.\nRemember to test it on "
			},
			{
				"_key": "863edd9034c91",
				"_type": "span",
				"marks": [
					"6787b7f8a513"
				],
				"text": "jsonlint.com"
			},
